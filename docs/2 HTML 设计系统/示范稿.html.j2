{% extends "issue.html.j2" %}
{% import "components/content.html.j2" as c %}
{% import "components/media.html.j2" as m %}
{% block sections %}
{% call c.section('sec-001','现场观察',2) %}
{% call c.article("art-001", "一次请求，为何出现两条记录", '新闻摘要', ["排版样文 · 假设的支付重试场景"]) %}
{{ c.paragraph("同一个订单号，十秒内出现两条“发起支付”日志。它们说明系统记录了两次支付发起事件。客户端等不到应答而重试，就可能留下这样的记录；单凭这两行，还无法判断实际扣了几次款。", true) }}
{{ c.paragraph("要查清结果，先按订单号找交易流水，再数有多少笔不同的成功扣款。若只有一笔，回到请求日志，用每次尝试的编号追查第二次请求为何发出。扣款次数和重试原因，各有对应的证据。") }}
{% endcall %}
{% call c.article("art-002", "平均耗时藏起了哪一次等待", '新闻摘要', ["排版样文 · 请求耗时为构造数据"]) %}
{{ c.paragraph("十次请求平均耗时两秒，可能是每次都花了两秒，也可能是九次各花一秒，另一次花了十一秒。两组数的总和都是二十秒，用户经历的等待却很不一样。", true) }}
{{ c.paragraph("要找到等得最久的那一次，查逐次请求的耗时，按时长排序，再用那条记录的请求编号追踪经过的服务。如果当时只存了平均值，事后就无法从“两秒”还原出是哪一次慢了。") }}
{% endcall %}
{% endcall %}
{% call c.section('sec-002','技术方法',1) %}
{% call c.article("art-003", "一份 120 GB 日志，磁盘一共搬了多少数据？", "讲解综述", ["排版样文 · 120 GB 为假设输入量，各阶段按等体积读写估算。"]) %}
{{ c.paragraph("最初生成有序段时，程序读完整份日志，再把相同体积的数据写回磁盘。此后每一轮归并都要再读、再写一次。把每个阶段结束时的账加起来，数字会逐步增长。", true) }}
{% call m.figure("mat-001", ["材料出处：本项目据假设数据绘制 · <a href=\"#src-mat-001\">估算依据</a>"|safe], [{"id": "src-mat-001", "title": "《当日志装不进内存》 · 磁盘上的代价，按整轮来算", "text": "把磁盘读写分别记账。生成初始段要读 120 GB，写 120 GB。第一轮归并读完全部初始段，再写出 120 GB。第二轮同样要读、写各一次。于是最终文件虽然只有 120 GB，整个过程累计搬运了约 720 GB。日志头部的几个字节可能参与了很多次内存比较，但在这个估算里，每轮只计算一次完整读取和一次完整写入。"}], "图注：各阶段结束时的累计磁盘读写量。") %}
{{ m.image(chart_uri, "三个阶段结束时，累计读写量依次为 240、480 和 720 GB。") }}
{% endcall %}
{{ c.heading("把读和写拆开", "sub-001") }}
{% call m.figure("mat-002", ["材料出处：《当日志装不进内存》 · <a href=\"#src-mat-002\">原文与计算条件</a>"|safe], [{"id": "src-mat-002", "title": "《当日志装不进内存》 · 磁盘上的代价，按整轮来算", "text": "把磁盘读写分别记账。生成初始段要读 120 GB，写 120 GB。第一轮归并读完全部初始段，再写出 120 GB。第二轮同样要读、写各一次。于是最终文件虽然只有 120 GB，整个过程累计搬运了约 720 GB。日志头部的几个字节可能参与了很多次内存比较，但在这个估算里，每轮只计算一次完整读取和一次完整写入。"}], "表注：中间两列仅计当轮，最后一列跨轮累计。") %}
{{ m.table(["完成阶段", "本阶段读取", "本阶段写入", "至此累计"], [["初始段写完", "120 GB", "120 GB", "240 GB"], ["第一轮归并结束", "120 GB", "120 GB", "480 GB"], ["第二轮归并结束", "120 GB", "120 GB", "720 GB"]], ["left", "right", "right", "right"]) }}
{% endcall %}
{{ c.paragraph("用代码复算时，先把每个阶段的一次读和一次写相加，再乘以阶段数。", true) }}
{% call m.figure("mat-003", ["材料出处：本项目编写的复核示例 · <a href=\"#src-mat-003\">算式依据</a>"|safe], [{"id": "src-mat-003", "title": "《当日志装不进内存》 · 磁盘上的代价，按整轮来算", "text": "把磁盘读写分别记账。生成初始段要读 120 GB，写 120 GB。第一轮归并读完全部初始段，再写出 120 GB。第二轮同样要读、写各一次。于是最终文件虽然只有 120 GB，整个过程累计搬运了约 720 GB。日志头部的几个字节可能参与了很多次内存比较，但在这个估算里，每轮只计算一次完整读取和一次完整写入。"}]) %}
{{ m.code("Python", "input_gb = 120\nmerge_passes = 2\ntotal_gb = 2 * input_gb * (1 + merge_passes)\nprint(total_gb)  # 720\n", "初次生成有序段也计入阶段数。") }}
{% endcall %}
{{ c.heading("读写量与剩余空间", "sub-002") }}
{% call m.figure("mat-004", ["材料出处：《当日志装不进内存》 · <a href=\"#src-mat-004\">原文段落</a>"|safe], [{"id": "src-mat-004", "title": "《当日志装不进内存》 · 中途停电以后，怎样知道做到哪里", "text": "这也解释了为什么空闲磁盘空间值得事先估算。某组的新输出已经接近写完时，它的旧输入还需要保留。假如还要长期留存原始日志，那么在整个排序期间，这些原始文件也一直占着空间。累计读写量回答的是“搬了多少”，峰值空间回答的是“同一刻放着多少”，两份数字分别影响等待时间和任务能否跑完。"}]) %}
{{ m.quote(["累计读写量回答的是“搬了多少”，峰值空间回答的是“同一刻放着多少”，两份数字分别影响等待时间和任务能否跑完。"]) }}
{% endcall %}
{{ c.paragraph("720 GB 可以用来估算搬运数据的耗时。要判断磁盘是否放得下，还要单独计算旧输入与新输出同时存在时的占用。", true) }}
{% endcall %}
{% endcall %}
{% endblock %}
