<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ title }} · {{ date }}</title>
  <style>{% include 'css/publication.css' %}</style>
  <style>{% include 'css/theme.css' %}</style>
{% block issue_styles %}{% endblock %}
</head>
<body>
<main>
  {% block masthead %}<header><h1>{{ title }}</h1><time datetime="{{ date }}">{{ date }}</time></header>{% endblock %}
  {% block sections %}{% endblock %}
</main>
</body>
</html>
